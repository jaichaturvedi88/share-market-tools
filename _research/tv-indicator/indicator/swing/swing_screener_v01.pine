//@version=6
// =============================================================================
//  Jai-Swing Trade Screener
//  Combines the swing-filter criteria into one indicator.
//  Use it two ways:
//    1. On a chart  -> centered status table (threshold, live value, pass/fail).
//    2. Pine Screener -> attach to a watchlist, filter on "Score" or "All met".
//  Note: this surfaces CANDIDATES, not buy/sell signals. Manage your own risk.
// =============================================================================
indicator("Jai-Swing Trade Screener", overlay = true)

// ----------------------------- Inputs ---------------------------------------
grpDir  = "Direction"
dir     = input.string("Long", "Trade direction", options = ["Long", "Short"], group = grpDir)

grpLiq  = "Liquidity, value & price"
minAvgVol      = input.int(500000, "Min avg volume (shares)", group = grpLiq)
volLen         = input.int(90,     "Avg volume lookback (bars)", group = grpLiq)
minTradedValue = input.float(50000000.0,   "Min daily traded value", group = grpLiq)
minMarketCap   = input.float(10000000000.0,"Min market cap (1000 Cr = 1e10)", group = grpLiq)
priceCeiling   = input.float(5000.0,"Price ceiling", group = grpLiq)

grpVol  = "Volatility"
atrLen     = input.int(14,   "ATR length", group = grpVol)
minAtrPct  = input.float(2.0,"Min ATR as % of price", group = grpVol)

grpTrend = "Trend"
maFast = input.int(50,  "Fast SMA", group = grpTrend)
maSlow = input.int(200, "Slow SMA", group = grpTrend)

grpMom = "Momentum"
rsiLen  = input.int(14, "RSI length", group = grpMom)
rsiLow  = input.float(40.0, "RSI band low", group = grpMom)
rsiHigh = input.float(60.0, "RSI band high", group = grpMom)

grpRs = "Relative strength"
benchmark = input.symbol("NSE:NIFTY", "Benchmark index", group = grpRs)
perfLen   = input.int(20, "RS lookback (bars)", group = grpRs)

grpRvol = "Relative volume"
rvolLen   = input.int(20,  "Relative volume lookback", group = grpRvol)
minRvol   = input.float(1.5,"Min relative volume", group = grpRvol)

isLong = dir == "Long"

// --------------------------- Helpers -----------------------------------------
// Indian-style compact number formatting: Cr (1e7), L (1e5).
f_inr(float v) =>
    av = math.abs(v)
    av >= 1e7 ? str.tostring(v / 1e7, "#.##") + "Cr" : av >= 1e5 ? str.tostring(v / 1e5, "#.##") + "L" : str.tostring(v, "#.##")

f_mark(bool ok) => ok ? "PASS" : "fail"
f_col(bool ok)  => ok ? color.new(color.green, 0) : color.new(color.red, 0)

// --------------------------- Calculations ------------------------------------
avgVol = ta.sma(volume, volLen)
smaF   = ta.sma(close, maFast)
smaS   = ta.sma(close, maSlow)
atrPct = (ta.atr(atrLen) / close) * 100.0
rsi    = ta.rsi(close, rsiLen)
rvol   = volume / ta.sma(volume, rvolLen)

// Market cap = shares outstanding x price (fundamental data; may be n/a).
shares    = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ", ignore_invalid_symbol = true)
marketCap = shares * close

benchClose = request.security(benchmark, timeframe.period, close, lookahead = barmerge.lookahead_off)
stockPerf  = (close - close[perfLen]) / close[perfLen] * 100.0
benchPerf  = (benchClose - benchClose[perfLen]) / benchClose[perfLen] * 100.0

// ----------------------------- Conditions ------------------------------------
cLiquidity = avgVol >= minAvgVol                               // 1
cTraded    = close * avgVol >= minTradedValue                  // 2
cMktCap    = not na(marketCap) and marketCap >= minMarketCap   // 3 (was price floor)
cCeiling   = close <= priceCeiling                             // 4
cVolatile  = atrPct >= minAtrPct                               // 5
cTrendSlow = isLong ? close > smaS : close < smaS              // 6
cTrendFast = isLong ? close > smaF : close < smaF              // 7
cStack     = isLong ? smaF > smaS : smaF < smaS                // 8
cRsi       = rsi >= rsiLow and rsi <= rsiHigh                  // 9
cRs        = isLong ? stockPerf > benchPerf : stockPerf < benchPerf  // 10
cRvol      = rvol >= minRvol                                   // 11
// 12 (earnings/event risk) cannot be checked reliably in Pine for future
// dates, so it is left for you to verify manually before entering.

score = (cLiquidity ? 1 : 0) + (cTraded ? 1 : 0) + (cMktCap ? 1 : 0) +
         (cCeiling ? 1 : 0) + (cVolatile ? 1 : 0) + (cTrendSlow ? 1 : 0) +
         (cTrendFast ? 1 : 0) + (cStack ? 1 : 0) + (cRsi ? 1 : 0) +
         (cRs ? 1 : 0) + (cRvol ? 1 : 0)

allMet = score == 11

// ------------------------- Plots for the Screener -----------------------------
plot(score,          "Score",   display = display.data_window)
plot(allMet ? 1 : 0, "All met", display = display.data_window)
plot(marketCap,      "Mkt cap", display = display.data_window)
plot(atrPct,         "ATR %",   display = display.data_window)
plot(rsi,            "RSI",     display = display.data_window)
plot(rvol,           "Rel vol", display = display.data_window)

plot(smaF, "Fast SMA", color = color.new(color.orange, 0))
plot(smaS, "Slow SMA", color = color.new(color.blue, 0))
bgcolor(allMet ? color.new(color.green, 85) : na, title = "All conditions met")

// ----------------------------- Status table ----------------------------------
// 7 columns: [label | value | status] [spacer] [label | value | status]
// Centered on the chart, 7 rows tall (header + 6).
var table t = table.new(position.middle_center, 7, 7, border_width = 1)
if barstate.islast
    // Header: title across the left block, score across the right block.
    table.cell(t, 0, 0, "Swing screener (" + dir + ")", text_color = color.white, bgcolor = color.new(color.gray, 0), text_size = size.small)
    table.merge_cells(t, 0, 0, 2, 0)
    table.cell(t, 3, 0, "", width = 2, bgcolor = na)
    table.cell(t, 4, 0, "Score " + str.tostring(score) + "/11", text_color = color.white, bgcolor = color.new(color.gray, 0), text_size = size.small)
    table.merge_cells(t, 4, 0, 6, 0)

    labels = array.from(
         "Liquidity (" + f_inr(minAvgVol) + ")",
         "Traded val (" + f_inr(minTradedValue) + ")",
         "Mkt cap (" + f_inr(minMarketCap) + ")",
         "Price <= " + str.tostring(priceCeiling, "#.##"),
         "Volatility (>=" + str.tostring(minAtrPct) + "%)",
         "Px vs SMA" + str.tostring(maSlow),
         "Px vs SMA" + str.tostring(maFast),
         "SMA" + str.tostring(maFast) + " vs " + str.tostring(maSlow),
         "RSI (" + str.tostring(rsiLow) + "-" + str.tostring(rsiHigh) + ")",
         "Rel strength",
         "Rel vol (>=" + str.tostring(minRvol) + "x)",
         "Event risk")

    vals = array.from(
         f_inr(avgVol),
         f_inr(close * avgVol),
         na(marketCap) ? "n/a" : f_inr(marketCap),
         str.tostring(close, "#.##"),
         str.tostring(atrPct, "#.##") + "%",
         str.tostring((close / smaS - 1) * 100, "#.#") + "%",
         str.tostring((close / smaF - 1) * 100, "#.#") + "%",
         str.tostring((smaF / smaS - 1) * 100, "#.#") + "%",
         str.tostring(rsi, "#.#"),
         str.tostring(stockPerf - benchPerf, "#.#") + "%",
         str.tostring(rvol, "#.##") + "x",
         "-")

    conds = array.from(cLiquidity, cTraded, cMktCap, cCeiling, cVolatile, cTrendSlow, cTrendFast, cStack, cRsi, cRs, cRvol)

    labelBg = color.new(color.gray, 70)

    // Left block (cols 0-2): items 0-5 on rows 1-6.
    for i = 0 to 5
        ok = array.get(conds, i)
        table.cell(t, 0, i + 1, array.get(labels, i), text_color = color.white, bgcolor = labelBg, text_size = size.small)
        table.cell(t, 1, i + 1, array.get(vals, i),   text_color = color.white, bgcolor = labelBg, text_size = size.small)
        table.cell(t, 2, i + 1, f_mark(ok),            text_color = color.white, bgcolor = f_col(ok), text_size = size.small)

    // Right block (cols 4-6): items 6-11 on rows 1-6. Item 11 is event risk.
    for i = 6 to 11
        r = i - 5
        table.cell(t, 4, r, array.get(labels, i), text_color = color.white, bgcolor = labelBg, text_size = size.small)
        table.cell(t, 5, r, array.get(vals, i),   text_color = color.white, bgcolor = labelBg, text_size = size.small)
        if i < 11
            ok = array.get(conds, i)
            table.cell(t, 6, r, f_mark(ok), text_color = color.white, bgcolor = f_col(ok), text_size = size.small)
        else
            table.cell(t, 6, r, "manual", text_color = color.white, bgcolor = color.new(color.orange, 0), text_size = size.small)
