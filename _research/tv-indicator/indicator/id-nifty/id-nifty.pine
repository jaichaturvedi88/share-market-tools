//@version=5
indicator("EMA Align + MACD Signal", overlay=true, max_labels_count=500)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
ema9_len  = input.int(9,  "EMA 9 Length",  minval=1)
ema26_len = input.int(26, "EMA 26 Length", minval=1)
ema50_len = input.int(50, "EMA 50 Length", minval=1)

macd_fast = input.int(12, "MACD Fast Length", minval=1)
macd_slow = input.int(26, "MACD Slow Length", minval=1)
macd_sig  = input.int(9,  "MACD Signal Length", minval=1)

show_emas       = input.bool(true, "Show EMAs")
show_bull_label = input.bool(true, "Show Bullish Signal Label")
show_bear_label = input.bool(true, "Show Bearish Signal Label")

// ─── EMA CALCULATIONS ─────────────────────────────────────────────────────────
ema9  = ta.ema(close, ema9_len)
ema26 = ta.ema(close, ema26_len)
ema50 = ta.ema(close, ema50_len)

// ─── MACD CALCULATION ─────────────────────────────────────────────────────────
[macdLine, signalLine, histLine] = ta.macd(close, macd_fast, macd_slow, macd_sig)

macd_rising  = macdLine > macdLine[1] and macdLine > signalLine
macd_falling = macdLine < macdLine[1] and macdLine < signalLine

// ─── RAW CONDITIONS ───────────────────────────────────────────────────────────
bull_aligned = ema9 > ema26 and ema26 > ema50
bull_close   = close > ema9
bull_raw     = bull_aligned and bull_close and macd_rising

bear_aligned = ema9 < ema26 and ema26 < ema50
bear_close   = close < ema9
bear_raw     = bear_aligned and bear_close and macd_falling

// ─── ONE SIGNAL ONLY ──────────────────────────────────────────────────────────
bull_signal = bull_raw and not bull_raw[1]
bear_signal = bear_raw and not bear_raw[1]

// ─── EMA PLOTS ────────────────────────────────────────────────────────────────
plot(show_emas ? ema9  : na, title="EMA 9",  color=color.new(color.orange, 0), linewidth=2)
plot(show_emas ? ema26 : na, title="EMA 26", color=color.new(color.blue, 0),   linewidth=2)
plot(show_emas ? ema50 : na, title="EMA 50", color=color.new(color.purple, 0), linewidth=2)

// ─── BACKGROUND HIGHLIGHT ─────────────────────────────────────────────────────
// bgcolor(bull_raw ? color.new(color.green, 88) : bear_raw ? color.new(color.red, 88) : na, title="Signal Background")

// ─── SIGNAL LABELS ────────────────────────────────────────────────────────────
plotshape(show_bull_label and bull_signal, title="Bullish Signal", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 10), textcolor=color.white, text="B", size=size.tiny)

plotshape(show_bear_label and bear_signal, title="Bearish Signal", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 10), textcolor=color.white, text="S", size=size.tiny)

// ─── ALERTS ───────────────────────────────────────────────────────────────────
alertcondition(bull_signal, title="Bullish EMA + MACD Signal", message="BUY Signal: EMAs aligned bullishly, price above EMA9, MACD rising.")
alertcondition(bear_signal, title="Bearish EMA + MACD Signal", message="SELL Signal: EMAs aligned bearishly, price below EMA9, MACD falling.")

// ─── INFO TABLE ───────────────────────────────────────────────────────────────
var table info = table.new(position.top_center, 2, 5, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.new(color.gray, 60))

table.cell(info, 0, 0, "Condition",    text_color=color.gray,  text_size=size.normal)
table.cell(info, 1, 0, "Status",       text_color=color.gray,  text_size=size.normal)

table.cell(info, 0, 1, "EMA Align",    text_color=color.white, text_size=size.normal)
table.cell(info, 1, 1, bull_aligned ? "✔ Bullish" : bear_aligned ? "✔ Bearish" : "✘ Mixed", text_color=bull_aligned ? color.green : bear_aligned ? color.red : color.gray, text_size=size.normal)

table.cell(info, 0, 2, "Close > EMA9", text_color=color.white, text_size=size.normal)
table.cell(info, 1, 2, bull_close ? "✔ Yes" : "✘ No", text_color=bull_close ? color.green : color.red, text_size=size.normal)

table.cell(info, 0, 3, "MACD Rising",  text_color=color.white, text_size=size.normal)
table.cell(info, 1, 3, macd_rising ? "✔ Yes" : "✘ No", text_color=macd_rising ? color.green : color.red, text_size=size.normal)

table.cell(info, 0, 4, "Signal",       text_color=color.white, text_size=size.normal)
table.cell(info, 1, 4, bull_signal ? "▲ B" : bear_signal ? "▼ S" : "— Wait", text_color=bull_signal ? color.green : bear_signal ? color.red : color.gray, text_size=size.normal)